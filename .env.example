# Copia este archivo como .env y rellena los valores. Nunca subas .env a GitHub.

# Contraseña para entrar en la app (obligatoria en Docker; si se deja vacía en local, no se pide).
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Si se deja vacío se genera uno y se guarda en el volumen de datos.
# Para generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Tienda de Apple Music (código de país de dos letras).
ITUNES_COUNTRY=es

# Pon "true" si la app está detrás de un proxy inverso con HTTPS ("true" = un proxy delante).
# Con varios proxies encadenados, pon su número (p. ej. 2) o la IP/subred del proxy (p. ej. 172.18.0.0/16).
# No lo actives si la app se expone directamente a internet: se podría falsear la IP de origen.
TRUST_PROXY=

# Pausa mínima (ms) entre peticiones a Record Club.
RC_DELAY_MS=700

# Actualizar automáticamente las colecciones de Record Club cada N horas (0 = no; 168 = semanal).
AUTO_SYNC_HOURS=0

# Puerto del host en docker-compose.
HOST_PORT=3000

# Solo para desarrollo local (npm run dev):
# PORT=3000
# DATA_DIR=./data
